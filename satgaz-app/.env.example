# WalletConnect Project ID — get one at https://cloud.walletconnect.com/
VITE_WALLETCONNECT_PROJECT_ID=your_project_id_here

# SubmissionEscrow contract address (deployed on Sepolia)
VITE_ESCROW_ADDRESS=0x0000000000000000000000000000000000000000

# ERC-20 payment token address (e.g. mock USDC on Sepolia)
VITE_PAYMENT_TOKEN_ADDRESS=0x0000000000000000000000000000000000000000

# CRE workflow HTTP trigger URL (from `cre workflow simulate` output)
# Used by the HTTP flow and EVM manual trigger fallback
VITE_WORKFLOW_HTTP_URL=http://localhost:8080
